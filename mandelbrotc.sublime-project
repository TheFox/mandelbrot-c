{
	"folders":[
		{
			"path": ".",
			"name": "MandelbrotC",
			"folder_exclude_patterns": [ ],
			"file_exclude_patterns": [ ]
		}
	],
	"build_systems":[
		{
			"name": "CMake",
			"cmd": [ "rm -rf build; mkdir -p build && cd build && cmake -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=/usr/local/bin/gcc -DCMAKE_CXX_COMPILER=/usr/local/bin/g++ .. && make && make test" ],
			"working_dir": "${project_path:${folder}}",
			"shell": true,
			"path": "$PATH:/usr/local/bin"
		},
		{
			"name": "Make",
			"cmd": [ "cd build && make" ],
			"working_dir": "${project_path:${folder}}",
			"shell": true,
			"path": "$PATH:/usr/local/bin"
		}
	]
}